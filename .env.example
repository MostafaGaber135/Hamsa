# Supabase dashboard → Project Settings → API (or "Connect")
VITE_SUPABASE_URL=https://your-project-id.supabase.co
# The publishable key (sb_publishable_...) or, on older projects, the "anon" public key.
# It is safe in the browser: Row Level Security is what protects the data.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional: push notifications. Generate a key pair with:  npx web-push generate-vapid-keys
# The public key goes here; both keys go into Supabase Edge Function secrets.
VITE_VAPID_PUBLIC_KEY=

# Optional: the site's public address, for link previews (Open Graph). No trailing slash.
VITE_SITE_URL=https://your-app.vercel.app

# Optional: error monitoring with Sentry (Project Settings → Client Keys → DSN).
VITE_SENTRY_DSN=
